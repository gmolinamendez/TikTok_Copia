rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cualquiera puede leer los videos (la app no usa login); nadie puede escribir desde la app.
    // Para agregar o editar videos, usa la consola de Firebase.
    match /videos/{videoId} {
      allow read: if true;
      allow write: if false;
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
